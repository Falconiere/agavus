# Copy this file to `.env` and adjust. Never commit `.env`.
AGAVUS_NAME=world

# Corpus (docs/corpus/storage.md). Real data never enters git.
AGAVUS_DATA_DIR=data
# Loaded for compatibility. Ingestion does not apply this floor.
AGAVUS_DATA_START=2020-01-01
# CNJ's published public DataJud key is the default; override only if needed.
# DATAJUD_API_KEY=

# Private learned-classifier experiment; never activates production routing.
AGAVUS_LEARNED_DEVICE=auto
AGAVUS_LEARNED_BUDGET_MINUTES=120
